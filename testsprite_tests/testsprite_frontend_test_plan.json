[
  {
    "id": "TC001",
    "title": "Send a text message and observe delivery/read status indicators",
    "description": "Verifies a user can send a text message in a 1:1 chat and see it appear with a visible status indicator update.",
    "category": "Chat Messaging",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "action",
        "description": "Click on any chat conversation in the chat list"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Message input\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"Hello from E2E test\" into the message input field"
      },
      {
        "type": "action",
        "description": "Click the \"Send\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Hello from E2E test\" is visible in the chat messages area"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Message status (sent/delivered/read)\" is visible for the most recent message"
      }
    ]
  },
